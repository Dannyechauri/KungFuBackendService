HOST=127.0.0.1
PORT=8080
NODE_ENV=development
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=kungfu_school
DB_USER=
DB_PASSWORD=
COOKIE_SECURE=false
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Comma-separated list of trusted reverse proxies (e.g. 10.0.0.0/8,127.0.0.1).
# Required in production when the backend sits behind a proxy; never trust all.
TRUSTED_PROXIES=
# Optional in development; required in production. Generate a 32-byte hex key.
SESSION_KEY=
